#!/command/with-contenv bash
# shellcheck shell=bash
# ==============================================================================
# HACC - Claude Code session wrapper
# Loads environment and starts Claude Code
# ==============================================================================

# Source environment configuration
if [[ -f /data/claude-config/env.sh ]]; then
    source /data/claude-config/env.sh
fi

# Export for subprocesses
export ANTHROPIC_API_KEY
export CLAUDE_CODE_MODEL
export CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS

cd /config || cd /

echo "=== HACC Debug ==="
echo "API Key set: ${ANTHROPIC_API_KEY:+yes}"
echo "Model: ${CLAUDE_CODE_MODEL:-default}"
echo "YOLO: ${CLAUDE_DANGEROUSLY_SKIP_PERMISSIONS:-false}"
echo "Claude location: $(which claude)"
echo "Node version: $(node --version)"
echo ".claude.json exists: $(test -f ~/.claude.json && echo yes || echo no)"
echo ".claude.json content: $(cat ~/.claude.json 2>/dev/null || echo 'N/A')"
echo "=================="
echo ""
echo "Type 'claude' to start Claude Code manually"
echo ""

exec bash
